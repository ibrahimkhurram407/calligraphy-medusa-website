// app/[countryCode]/(main)/account/page.tsx

import { retrieveCustomer } from "@lib/data/customer"
import { Toaster } from "@medusajs/ui"
import AccountLayout from "@modules/account/templates/account-layout"
import TriggerCustomerUpdate from "@modules/account/components/trigger-customer-update"
import Dashboard from "./dashboard/page"
import Login from "./login/page"
import EmailVerification from "./email_verification/page"

export default async function AccountPage() {
  const customer = await retrieveCustomer().catch(() => null)

  let content: React.ReactNode = <Login />

  if (customer) {
    content = customer.metadata?.email_verified ? <Dashboard /> : <EmailVerification />
  }

  return (
    <AccountLayout customer={customer}>
      {content}
      <Toaster />
      <TriggerCustomerUpdate customer={customer} />
    </AccountLayout>
  )
}
